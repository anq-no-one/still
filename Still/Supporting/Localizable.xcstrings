            "value" : "De App Store is niet bereikbaar. Opnemen blijft werken."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "App Store jest niedostępny. Nagrywanie nadal działa."
          }
        },
        "pt-PT" : {
