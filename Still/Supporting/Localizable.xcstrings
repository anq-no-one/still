    "Waiting for approval. Still unlocks Pro as soon as it is approved.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Warten auf Genehmigung. Still schaltet Pro frei, sobald sie genehmigt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Esperando aprobación. Still desbloquea Pro en cuanto se apruebe."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "En attente d'approbation. Still débloque Pro dès qu'elle est approuvée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
