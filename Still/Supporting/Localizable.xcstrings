    "Decisions from this project's recordings appear here, with earlier ones kept beside the current one." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Entscheidungen aus den Aufnahmen dieses Projekts erscheinen hier, frühere bleiben neben der aktuellen erhalten."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Las decisiones de las grabaciones de este proyecto aparecen aquí, con las anteriores junto a la actual."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
