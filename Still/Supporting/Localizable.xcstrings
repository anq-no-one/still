    "Deleting a recording keeps it recoverable for 30 days before Still removes it for good, on this device and on the ones it syncs with.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn du eine Aufnahme löschst, bleibt sie 30 Tage lang wiederherstellbar, bevor Still sie endgültig entfernt, auf diesem Gerät und auf den Geräten, mit denen sie synchronisiert wird."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Al eliminar una grabación, esta permanece recuperable durante 30 días antes de que Still la elimine definitivamente, en este dispositivo y en aquellos con los que se sincroniza."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Quand vous supprimez un enregistrement, il reste récupérable pendant 30 jours avant que Still ne le supprime définitivement, sur cet appareil et sur ceux avec lesquels il se synchronise."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "L'eliminazione di una registrazione la mantiene recuperabile per 30 giorni prima che Still la rimuova definitivamente, su questo dispositivo e su quelli con cui si sincronizza."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Als je een opname verwijdert, blijft deze 30 dagen herstelbaar voordat Still deze definitief verwijdert, op dit toestel en op de toestellen waarmee het synchroniseert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Usunięte nagranie można odzyskać przez 30 dni, zanim Still usunie je na stałe — na tym urządzeniu i na tych, z którymi się synchronizuje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Ao eliminar uma gravação, esta fica recuperável durante 30 dias antes de o Still a remover definitivamente, neste dispositivo e nos que sincroniza."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "После удаления запись можно восстановить в течение 30 дней, прежде чем Still удалит её навсегда — на этом устройстве и на тех, с которыми идёт синхронизация."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "När du raderar en inspelning kan du återställa den i 30 dagar innan Still tar bort den permanent, på den här enheten och på de enheter den synkroniserar med."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Видалений запис можна відновити протягом 30 днів, перш ніж Still видалить його остаточно — на цьому пристрої й на тих, з якими триває синхронізація."
          }
        }
      }
    },
