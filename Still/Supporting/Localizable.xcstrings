    "Moves project vocabulary, the shortcut, and ordinary preferences to another device. Keys, permissions, and consents never leave this device." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verschiebt das Projektvokabular, die Tastenkombination und gewöhnliche Einstellungen auf ein anderes Gerät. Schlüssel, Berechtigungen und Zustimmungen verlassen dieses Gerät nie."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Traslada el vocabulario del proyecto, el atajo y las preferencias ordinarias a otro dispositivo. Las claves, los permisos y los consentimientos nunca salen de este dispositivo."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Transfère le vocabulaire du projet, le raccourci et les préférences ordinaires vers un autre appareil. Les clés, les autorisations et les consentements ne quittent jamais cet appareil."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Sposta il vocabolario del progetto, la scorciatoia e le preferenze ordinarie su un altro dispositivo. Chiavi, autorizzazioni e consensi non lasciano mai questo dispositivo."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Verplaatst de projectwoordenlijst, de sneltoets en gewone voorkeuren naar een ander apparaat. Sleutels, machtigingen en toestemmingen verlaten dit apparaat nooit."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Przenosi słownik projektu, skrót i zwykłe ustawienia na inne urządzenie. Klucze, uprawnienia i zgody nigdy nie opuszczają tego urządzenia."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Move o vocabulário do projeto, o atalho e as preferências habituais para outro dispositivo. As chaves, permissões e consentimentos nunca saem deste dispositivo."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносит словарь проекта, комбинацию клавиш и обычные настройки на другое устройство. Ключи, разрешения и согласия никогда не покидают это устройство."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Flyttar projektets ordlista, genvägen och vanliga inställningar till en annan enhet. Nycklar, behörigheter och samtycken lämnar aldrig den här enheten."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Переносить словник проєкту, комбінацію клавіш і звичайні параметри на інший пристрій. Ключі, дозволи та згоди ніколи не покидають цей пристрій."
          }
        }
      }
    },
