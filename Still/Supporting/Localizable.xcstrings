    "Your recordings are always encrypted. The lock also hides them behind Face ID, Touch ID, or your device password. Recording keeps going while Still is locked.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahmen sind immer verschlüsselt. Die Sperre versteckt sie zusätzlich hinter Face ID, Touch ID oder deinem Gerätepasswort. Die Aufnahme läuft weiter, während Still gesperrt ist."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus grabaciones siempre están cifradas. El bloqueo también las oculta tras Face ID, Touch ID o la contraseña de tu dispositivo. La grabación sigue en marcha mientras Still está bloqueada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements sont toujours chiffrés. Le verrouillage les cache aussi derrière Face ID, Touch ID ou le mot de passe de votre appareil. L'enregistrement continue pendant que Still est verrouillée."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue registrazioni sono sempre crittografate. Il blocco le nasconde anche dietro Face ID, Touch ID o la password del tuo dispositivo. La registrazione continua mentre Still è bloccata."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opnamen zijn altijd versleuteld. De vergrendeling verbergt ze ook achter Face ID, Touch ID of je toestelwachtwoord. Opnemen blijft doorgaan terwijl Still vergrendeld is."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje nagrania są zawsze zaszyfrowane. Blokada dodatkowo ukrywa je za Face ID, Touch ID lub hasłem urządzenia. Nagrywanie trwa nadal, gdy Still jest zablokowany."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas gravações estão sempre encriptadas. O bloqueio também as esconde atrás do Face ID, Touch ID ou da senha do dispositivo. A gravação continua enquanto o Still está bloqueado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи всегда зашифрованы. Блокировка дополнительно скрывает их за Face ID, Touch ID или паролем устройства. Запись продолжается, даже когда Still заблокирован."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inspelningar är alltid krypterade. Låset döljer dem också bakom Face ID, Touch ID eller din enhetslösenord. Inspelningen fortsätter medan Still är låst."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші записи завжди зашифровані. Блокування додатково приховує їх за Face ID, Touch ID або паролем пристрою. Запис триває, навіть коли Still заблоковано."
          }
        }
      }
    },
    "Your recordings stay hidden until you unlock Still.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Deine Aufnahmen bleiben verborgen, bis du Still entsperrst."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Tus grabaciones permanecen ocultas hasta que desbloquees Still."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Vos enregistrements restent cachés jusqu'à ce que vous déverrouilliez Still."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Le tue registrazioni restano nascoste finché non sblocchi Still."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Je opnamen blijven verborgen totdat je Still ontgrendelt."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Twoje nagrania pozostają ukryte, dopóki nie odblokujesz Still."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "As suas gravações ficam escondidas até desbloquear o Still."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваши записи остаются скрытыми, пока вы не разблокируете Still."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Dina inspelningar förblir dolda tills du låser upp Still."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Ваші записи залишаються прихованими, поки ви не розблокуєте Still."
          }
        }
      }
    },
