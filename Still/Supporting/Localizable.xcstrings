    "Press, then type the new shortcut. Escape cancels.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Drücken und dann das neue Tastenkürzel eingeben. Escape bricht ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Pulsa y luego escribe el nuevo atajo. Escape cancela."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Appuyez, puis saisissez le nouveau raccourci. Échap annule."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Premi, poi digita la nuova scorciatoia. Esc annulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Druk en typ vervolgens de nieuwe sneltoets. Escape annuleert."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Naciśnij, a następnie wpisz nowy skrót. Escape anuluje."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Prima e depois escreva o novo atalho. Escape cancela."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
