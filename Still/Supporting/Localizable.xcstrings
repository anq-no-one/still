    "Another browser tab played sound during %@. It may be mixed into the transcript there.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein anderer Browser-Tab hat während %@ Ton wiedergegeben. Er könnte dort in das Transkript eingemischt worden sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Otra pestaña del navegador reprodujo sonido durante %@. Es posible que se haya mezclado con la transcripción en ese punto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un autre onglet du navigateur a diffusé du son pendant %@. Il est possible qu'il se soit mêlé à la transcription à cet endroit."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un'altra scheda del browser ha riprodotto audio durante %@. Potrebbe essersi mescolato alla trascrizione in quel punto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Een ander browsertabblad speelde geluid af tijdens %@. Dat kan in het transcript daar zijn meegemengd."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inna karta przeglądarki odtwarzała dźwięk podczas %@. Mógł zostać wmieszany w tę transkrypcję."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Outro separador do navegador reproduziu som durante %@. Pode estar misturado na transcrição."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Во время %@ звук воспроизводился в другой вкладке браузера. Он мог попасть в эту транскрипцию."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "En annan webbläsarflik spelade upp ljud under %@. Det kan ha blandats in i transkriptionen där."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Під час %@ звук відтворювався в іншій вкладці браузера. Він міг потрапити в цю транскрипцію."
          }
        }
      }
    },
