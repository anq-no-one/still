    "One purchase unlocks Still Pro on iPhone, iPad, and Mac, and Family Sharing covers your household.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Ein Kauf schaltet Still Pro auf iPhone, iPad und Mac frei, und die Familienfreigabe deckt deinen ganzen Haushalt ab."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Una sola compra desbloquea Still Pro en iPhone, iPad y Mac, y Compartir en familia cubre a todo tu hogar."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Un seul achat débloque Still Pro sur iPhone, iPad et Mac, et le Partage familial couvre tout votre foyer."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Un solo acquisto sblocca Still Pro su iPhone, iPad e Mac, e In famiglia copre tutti i membri della tua famiglia."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Eén aankoop ontgrendelt Still Pro op iPhone, iPad en Mac, en Gezinsdeling dekt je hele huishouden."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeden zakup odblokowuje Still Pro na iPhonie, iPadzie i Macu, a Rodzina w chmurze obejmuje całe twoje gospodarstwo domowe."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Uma única compra desbloqueia o Still Pro no iPhone, iPad e Mac, e a Partilha Familiar abrange a sua casa."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка открывает Still Pro на iPhone, iPad и Mac, а функция «Семейный доступ» распространяется на всю семью."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ett köp låser upp Still Pro på iPhone, iPad och Mac, och Familjedelning omfattar hela hushållet."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Одна покупка відкриває Still Pro на iPhone, iPad і Mac, а «Сімейний доступ» поширюється на всю родину."
          }
        }
      }
    },
