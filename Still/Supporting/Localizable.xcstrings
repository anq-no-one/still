    "Starts recording on this device. Nothing is uploaded.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Startet die Aufnahme auf diesem Gerät. Es wird nichts hochgeladen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia la grabación en este dispositivo. No se sube nada."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Démarre l'enregistrement sur cet appareil. Rien n'est envoyé en ligne."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Avvia la registrazione su questo dispositivo. Non viene caricato nulla."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Start de opname op dit toestel. Er wordt niets geüpload."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rozpoczyna nagrywanie na tym urządzeniu. Nic nie jest wysyłane."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Inicia a gravação neste dispositivo. Nada é carregado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Начинает запись на этом устройстве. Ничего не отправляется."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Startar inspelning på den här enheten. Inget laddas upp."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Починає запис на цьому пристрої. Нічого не надсилається."
