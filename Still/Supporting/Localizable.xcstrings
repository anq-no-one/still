        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Still не зміг відкрити цей файл. Переконайтеся, що він досі існує і доступний для читання, потім спробуйте ще раз."
          }
        }
      }
    },
    "Still could not read any audio in this file. It may be damaged or incomplete.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Still konnte in dieser Datei kein Audio lesen. Sie könnte beschädigt oder unvollständig sein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Still no pudo leer ningún audio en este archivo. Puede estar dañado o incompleto."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Still n'a trouvé aucun audio lisible dans ce fichier. Il est peut-être endommagé ou incomplet."
          }
        },
        "it": {
