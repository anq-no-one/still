    "Each project keeps its own spellings of names and terms. Still applies them to new recordings in that project." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Jedes Projekt behält seine eigene Schreibweise von Namen und Begriffen. Still wendet sie auf neue Aufnahmen in diesem Projekt an."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada proyecto mantiene su propia forma de escribir nombres y términos. Still la aplica a las nuevas grabaciones de ese proyecto."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Chaque projet conserve sa propre orthographe des noms et des termes. Still l'applique aux nouveaux enregistrements de ce projet."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ogni progetto mantiene la propria grafia di nomi e termini. Still la applica alle nuove registrazioni di quel progetto."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Elk project bewaart zijn eigen schrijfwijze van namen en termen. Still past die toe op nieuwe opnamen binnen dat project."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Każdy projekt zachowuje własną pisownię nazw i terminów. Still stosuje ją w nowych nagraniach tego projektu."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cada projeto mantém a sua própria grafia de nomes e termos. O Still aplica-a às novas gravações desse projeto."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Каждый проект хранит собственное написание имён и терминов. Still применяет его к новым записям в этом проекте."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Varje projekt behåller sin egen stavning av namn och termer. Still tillämpar den på nya inspelningar i det projektet."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Кожен проєкт зберігає власне написання імен і термінів. Still застосовує його до нових записів у цьому проєкті."
          }
        }
      }
    },
