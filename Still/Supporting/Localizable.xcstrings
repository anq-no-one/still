    "Projects sync to your other devices, encrypted like your recordings." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Projekte werden verschlüsselt wie deine Aufnahmen mit deinen anderen Geräten synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Los proyectos se sincronizan con tus otros dispositivos, cifrados igual que tus grabaciones."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Les projets se synchronisent avec vos autres appareils, chiffrés comme vos enregistrements."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
