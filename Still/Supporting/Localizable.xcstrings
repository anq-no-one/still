    "Sound is playing in %@. Your microphone may pick it up.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ wird Ton wiedergegeben. Dein Mikrofon könnte ihn aufnehmen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Se está reproduciendo sonido en %@. Es posible que tu micrófono lo capte."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Du son est diffusé dans %@. Votre micro pourrait le capter."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "In %@ è in riproduzione un suono. Il tuo microfono potrebbe captarlo."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Er wordt geluid afgespeeld in %@. Je microfoon kan dit oppikken."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W %@ odtwarzany jest dźwięk. Twój mikrofon może go wychwycić."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Está a tocar som em %@. O seu microfone pode captá-lo."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "В %@ воспроизводится звук. Ваш микрофон может его уловить."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Ljud spelas upp i %@. Din mikrofon kan fånga upp det."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "У %@ відтворюється звук. Ваш мікрофон може його вловити."
          }
        }
      }
    },
