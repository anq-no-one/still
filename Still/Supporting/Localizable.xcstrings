    "Your Library is locked, so AI tools get an error until you unlock it." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Deine Bibliothek ist gesperrt, daher erhalten KI-Tools einen Fehler, bis du sie entsperrst."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Tu biblioteca está bloqueada, así que las herramientas de IA reciben un error hasta que la desbloquees."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Votre bibliothèque est verrouillée, donc les outils d'IA reçoivent une erreur jusqu'à ce que vous la déverrouilliez."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "La tua libreria è bloccata, quindi gli strumenti IA ricevono un errore finché non la sblocchi."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Je bibliotheek is vergrendeld, dus AI-tools krijgen een foutmelding totdat je deze ontgrendelt."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Twoja Biblioteka jest zablokowana, więc narzędzia AI otrzymują błąd, dopóki jej nie odblokujesz."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "A sua Biblioteca está bloqueada, por isso as ferramentas de IA recebem um erro até a desbloquear."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ваша библиотека заблокирована, поэтому инструменты ИИ получают ошибку, пока вы её не разблокируете."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Ditt bibliotek är låst, så AI-verktyg får ett fel tills du låser upp det."
