    "Other devices stop reading anything this Library writes from now on.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere Geräte können ab sofort nichts mehr lesen, was diese Bibliothek schreibt."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "A partir de ahora, los demás dispositivos dejan de poder leer lo que escribe esta biblioteca."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les autres appareils ne pourront plus lire ce que cette bibliothèque écrit à partir de maintenant."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Da questo momento, gli altri dispositivi smettono di poter leggere ciò che questa libreria scrive."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Andere toestellen lezen vanaf nu niets meer wat deze bibliotheek schrijft."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Inne urządzenia od teraz przestają odczytywać cokolwiek, co zapisuje ta Biblioteka."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os outros dispositivos deixam de ler o que esta Biblioteca escrever a partir de agora."
