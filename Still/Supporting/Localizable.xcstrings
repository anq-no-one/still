    "Use Command, Option, or Control with the key, so typing in other apps never starts a recording.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Verwende Befehl, Wahl oder Control zusammen mit der Taste, damit Tippen in anderen Apps nie eine Aufnahme startet."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Comando, Opción o Control junto con la tecla, para que escribir en otras apps nunca inicie una grabación."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilisez Commande, Option ou Contrôle avec la touche, afin que taper dans d'autres applications ne démarre jamais un enregistrement."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "Usa Comando, Opzione o Controllo insieme al tasto, così digitare in altre app non avvia mai una registrazione."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Gebruik Command, Option of Control samen met de toets, zodat typen in andere apps nooit een opname start."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Użyj klawisza Command, Option lub Control razem z inną klawiszem, aby pisanie w innych aplikacjach nigdy nie uruchamiało nagrywania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Utilize Comando, Opção ou Controlo com a tecla, para que escrever noutras aplicações nunca inicie uma gravação."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Используйте Command, Option или Control вместе с клавишей, чтобы набор текста в других приложениях никогда не запускал запись."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Använd Kommando, Alternativ eller Kontroll tillsammans med tangenten, så att skrivande i andra appar aldrig startar en inspelning."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Використовуйте Command, Option або Control разом із клавішею, щоб набір тексту в інших застосунках ніколи не запускав запис."
          }
        }
      }
    },
