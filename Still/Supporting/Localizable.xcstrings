    "This recording stays on this device until you confirm its project. Then it syncs to your other devices." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Diese Aufnahme bleibt auf diesem Gerät, bis du ihr Projekt bestätigst. Danach wird sie mit deinen anderen Geräten synchronisiert."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Esta grabación permanece en este dispositivo hasta que confirmes su proyecto. Luego se sincroniza con tus otros dispositivos."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Cet enregistrement reste sur cet appareil jusqu'à ce que vous confirmiez son projet. Il se synchronise ensuite avec vos autres appareils."
          }
