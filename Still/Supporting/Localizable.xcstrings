    "%@ is unavailable and no other microphone is connected.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ ist nicht verfügbar, und es ist kein anderes Mikrofon angeschlossen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ no está disponible y no hay ningún otro micrófono conectado."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ n'est pas disponible et aucun autre micro n'est connecté."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ non è disponibile e non è collegato nessun altro microfono."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ is niet beschikbaar en er is geen andere microfoon aangesloten."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ jest niedostępny i nie podłączono żadnego innego mikrofonu."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ está indisponível e não há outro microfone ligado."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ недоступен, а другой микрофон не подключён."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ är inte tillgänglig och ingen annan mikrofon är ansluten."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ недоступний, і інший мікрофон не підключено."
          }
        }
      }
    },
    "%@ starts and stops from anywhere": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startet und stoppt von überall"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inicia y detiene desde cualquier lugar"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ démarre et arrête depuis n'importe où"
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ avvia e interrompe da qualsiasi punto"
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ start en stopt vanaf overal"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ uruchamia i zatrzymuje z dowolnego miejsca"
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ inicia e para a partir de qualquer lugar"
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запускает и останавливает из любого места"
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ startar och stoppar var du än är"
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "%@ запускає і зупиняє з будь-якого місця"
          }
        }
