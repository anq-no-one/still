    "Projects sync to your other devices, encrypted like your recordings.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekte werden verschlüsselt wie deine Aufnahmen mit deinen anderen Geräten synchronisiert."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Los proyectos se sincronizan con tus otros dispositivos, cifrados igual que tus grabaciones."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Les projets se synchronisent avec vos autres appareils, chiffrés comme vos enregistrements."
          }
        },
        "it": {
          "stringUnit": {
            "state": "translated",
            "value": "I progetti si sincronizzano con i tuoi altri dispositivi, crittografati come le tue registrazioni."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projecten worden gesynchroniseerd met je andere toestellen, versleuteld zoals je opnamen."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekty synchronizują się z innymi urządzeniami, zaszyfrowane tak samo jak nagrania."
          }
        },
        "pt-PT": {
          "stringUnit": {
            "state": "translated",
            "value": "Os projetos sincronizam com os seus outros dispositivos, encriptados tal como as suas gravações."
          }
        },
        "ru": {
          "stringUnit": {
            "state": "translated",
            "value": "Проекты синхронизируются с другими вашими устройствами, зашифрованные так же, как и записи."
          }
        },
        "sv": {
          "stringUnit": {
            "state": "translated",
            "value": "Projekt synkroniseras till dina andra enheter, krypterade precis som dina inspelningar."
          }
        },
        "uk": {
          "stringUnit": {
            "state": "translated",
            "value": "Проєкти синхронізуються з іншими вашими пристроями, зашифровані так само, як і записи."
          }
        }
      }
    },
