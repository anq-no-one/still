            "value": "Still non è riuscita a leggere alcun audio in questo file. Potrebbe essere danneggiato o incompleto."
          }
        },
        "nl": {
          "stringUnit": {
            "state": "translated",
            "value": "Still kon geen audio in dit bestand lezen. Het kan beschadigd of onvolledig zijn."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Still nie mógł odczytać żadnego dźwięku w tym pliku. Może być uszkodzony lub niekompletny."
