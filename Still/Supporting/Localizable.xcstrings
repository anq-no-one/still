            "value" : "Réglages Still"
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Impostazioni di Still"
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
