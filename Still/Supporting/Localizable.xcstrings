    "Set a passcode for this device in Settings, then unlock Still with it.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lege in den Einstellungen einen Code für dieses Gerät fest und entsperre Still damit."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Configura un código para este dispositivo en Ajustes y luego desbloquea Still con él."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Définissez un code pour cet appareil dans les réglages, puis déverrouillez Still avec."
          }
        },
        "it": {
          "stringUnit": {
