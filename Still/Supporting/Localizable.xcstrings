    "Tells apart the people speaking in a recording, on this device, and recognizes voices you have named before." : {
      "localizations" : {
        "de" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Unterscheidet die sprechenden Personen in einer Aufnahme auf diesem Gerät und erkennt Stimmen, die du zuvor benannt hast."
          }
        },
        "es" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue a las personas que hablan en una grabación, en este dispositivo, y reconoce las voces que ya has nombrado antes."
          }
        },
        "fr" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue les personnes qui parlent dans un enregistrement, sur cet appareil, et reconnaît les voix que vous avez déjà nommées."
          }
        },
        "it" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue le persone che parlano in una registrazione, su questo dispositivo, e riconosce le voci che hai già nominato in precedenza."
          }
        },
        "nl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Onderscheidt de mensen die spreken in een opname, op dit toestel, en herkent stemmen die je eerder hebt benoemd."
          }
        },
        "pl" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Rozróżnia osoby mówiące w nagraniu, na tym urządzeniu, i rozpoznaje głosy, które wcześniej nazwałeś."
          }
        },
        "pt-PT" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Distingue as pessoas que falam numa gravação, neste dispositivo, e reconhece vozes que já nomeou."
          }
        },
        "ru" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Различает людей, говорящих в записи, на этом устройстве, и распознаёт голоса, которые вы уже называли."
          }
        },
        "sv" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Skiljer på personerna som talar i en inspelning, på den här enheten, och känner igen röster du namngett tidigare."
          }
        },
        "uk" : {
          "stringUnit" : {
            "state" : "translated",
            "value" : "Розрізняє людей, які говорять у записі, на цьому пристрої, і розпізнає голоси, які ви вже називали."
          }
        }
      }
    },
