require "base64"
require "tmpdir"

default_platform(:ios)

OP_ITEM = ENV.fetch("STILL_OP_ASC_KEY_ITEM", "op://Personal/colouring - App Store Connect API")
ROOT = File.expand_path("..", __dir__)
BUILD_DIR = File.join(ROOT, "Release", "build")

def op_field(name)
  value = (ENV["STILL_OP_#{name}"] || sh("op", "read", "#{OP_ITEM}/#{name}", log: false)).strip
  UI.user_error!("1Password field #{name} is empty") if value.empty?
  value
end

def team_id
  @team_id ||= ENV["STILL_TEAM_ID"] || op_field("TEAM_ID")
end

def asc_api_key
  @asc_api_key ||= begin
    content = op_field("APP_STORE_KEY_CONTENT")
    key = app_store_connect_api_key(
      key_id: op_field("APP_STORE_KEY_ID"),
      issuer_id: op_field("APP_STORE_ISSUER_ID"),
      key_content: content,
      is_key_content_base64: !content.include?("BEGIN"),
      in_house: false
    )
    @key_path = File.join(Dir.mktmpdir("still-asc"), "AuthKey_#{key[:key_id]}.p8")
    pem = key[:key].include?("BEGIN") ? key[:key] : Base64.decode64(key[:key])
    File.write(@key_path, pem)
    File.chmod(0o600, @key_path)
    key
  end
end

def provisioning_xcargs
  key = asc_api_key
  [
    "DEVELOPMENT_TEAM=#{team_id}",
    "-allowProvisioningUpdates",
    "-skipPackagePluginValidation",
    "-skipMacroValidation",
    "-authenticationKeyPath #{@key_path.shellescape}",
    "-authenticationKeyID #{key[:key_id]}",
    "-authenticationKeyIssuerID #{key[:issuer_id]}"
  ].join(" ")
end

def export_options(platform)
  plist = Plist.parse_xml(File.join(ROOT, "Release", "ExportOptions-#{platform}.plist"))
  plist["teamID"] = team_id
  plist
end

def marketing_version
  ENV.fetch("STILL_MARKETING_VERSION", "1.0")
end

def next_build_number(platform)
  latest = latest_testflight_build_number(api_key: asc_api_key, platform: platform == "macOS" ? "osx" : "ios", initial_build_number: 0)
  [latest.to_i + 1, Time.now.utc.strftime("%Y%m%d%H").to_i].max
end

def beta_tag(platform:, version:, build_number:)
  "testflight-#{platform}-#{version}-#{build_number}"
end

def canonical_project_text(path)
  File.read(File.join(ROOT, path)).gsub(/[0-9A-F]{16,}/, "ID").lines.sort.join
end

def committed_canonical_project_text(path)
  `git -C #{ROOT.shellescape} show HEAD:#{path.shellescape} 2>/dev/null`.gsub(/[0-9A-F]{16,}/, "ID").lines.sort.join
end

def xcodegen_regen!
  project = File.join("Still.xcodeproj", "project.pbxproj")
  attempts = (ENV["STILL_XCODEGEN_ATTEMPTS"] || "10").to_i
  attempts.times do |i|
    sh("xcodegen", "generate", "--spec", File.join(ROOT, "project.yml"), "--project", ROOT)
    dirty = `git -C #{ROOT.shellescape} status --porcelain -- #{project.shellescape}`.lines.map { |l| l[3..].strip }
    return if dirty.empty?
    if dirty.all? { |p| !canonical_project_text(p).empty? && canonical_project_text(p) == committed_canonical_project_text(p) }
      sh("git", "-C", ROOT, "checkout", "--", "Still.xcodeproj")
      UI.message("Ignoring nondeterministic xcodegen ID assignment; building the committed project")
      return
    end
    UI.message("xcodegen output differs beyond IDs (attempt #{i + 1}/#{attempts}); regenerating")
  end
  UI.user_error!("xcodegen keeps producing a project that differs from the commit beyond " \
    "nondeterministic ID assignment. Known cause: it randomly swaps the two Still-macOS " \
    "Embed Dependencies copy phases. Regenerate locally until the committed layout comes out, " \
    "then commit that project first.")
end

def build(scheme:, platform:, destination:, version:, build_number:)
  build_app(
    project: File.join(ROOT, "Still.xcodeproj"),
    scheme: scheme,
    destination: destination,
    output_directory: File.join(BUILD_DIR, platform),
    archive_path: File.join(BUILD_DIR, "#{scheme}.xcarchive"),
    export_options: export_options(platform),
    xcargs: "#{provisioning_xcargs} MARKETING_VERSION=#{version} CURRENT_PROJECT_VERSION=#{build_number}",
    skip_profile_detection: true
  )
end

RUNTIME_SYMBOLS_NEWER_THAN_DEPLOYMENT_TARGET = %w[_swift_initBorrow].freeze

def verify_runs_on_deployment_target!(scheme)
  app = Dir[File.join(BUILD_DIR, "#{scheme}.xcarchive", "Products", "Applications", "*.app")].first
  info = Dir[File.join(app, "{Contents/,}Info.plist")].first
  info_xml = sh("/usr/bin/plutil", "-convert", "xml1", "-o", "-", info, log: false)
  executable = Plist.parse_xml(info_xml)["CFBundleExecutable"]
  binary = Dir[File.join(app, "{Contents/MacOS/,}#{executable}")].first
  imported = `nm -u #{binary.shellescape}`.split
  offending = RUNTIME_SYMBOLS_NEWER_THAN_DEPLOYMENT_TARGET & imported
  UI.user_error!("#{scheme} imports #{offending.join(', ')}, which the deployment target's Swift runtime lacks") unless offending.empty?
end

def ship(scheme:, platform:, destination:, tf_platform:, pkg: false)
  xcodegen_regen!
  version = marketing_version
  build_number = next_build_number(platform)
  build(scheme: scheme, platform: platform, destination: destination, version: version, build_number: build_number)
  verify_runs_on_deployment_target!(scheme)
  if pkg
    upload_to_testflight(api_key: asc_api_key, app_platform: "osx", pkg: lane_context[SharedValues::PKG_OUTPUT_PATH], skip_waiting_for_build_processing: true)
  else
    upload_to_testflight(api_key: asc_api_key, skip_waiting_for_build_processing: true)
  end
  tag = beta_tag(platform: tf_platform, version: version, build_number: build_number)
  add_git_tag(tag: tag)
  push_to_git_remote
  push_git_tags(tag: tag)
  UI.success("Uploaded #{scheme} #{version} (#{build_number}) and tagged #{tag}")
end

def deliver_metadata(platform:, metadata_path:)
  deliver(
    api_key: asc_api_key,
    platform: platform,
    metadata_path: File.join(ROOT, "fastlane", metadata_path),
    screenshots_path: File.join(ROOT, "fastlane", "screenshots", platform),
    skip_binary_upload: true,
    skip_screenshots: !Dir.exist?(File.join(ROOT, "fastlane", "screenshots", platform)),
    overwrite_screenshots: true,
    submit_for_review: false,
    run_precheck_before_submit: false,
    force: true
  )
end

desc "Build and upload both iOS and macOS builds to TestFlight, tagging each"
lane :beta_all do
  ship(scheme: "Still-iOS", platform: "iOS", destination: "generic/platform=iOS", tf_platform: "ios")
  ship(scheme: "Still-macOS", platform: "macOS", destination: "generic/platform=macOS", tf_platform: "macos", pkg: true)
end

desc "Confirm the App Store Connect key works and the Still app record exists"
lane :doctor do
  asc_api_key
  app = Spaceship::ConnectAPI::App.find("com.andrii.still")
  UI.user_error!("No App Store Connect app record for com.andrii.still") unless app
  UI.success("App record #{app.id} \"#{app.name}\" is reachable")
end

platform :ios do
  desc "Upload the iPhone and iPad listing: metadata and screenshots"
  lane :metadata do
    deliver_metadata(platform: "ios", metadata_path: "metadata")
  end

  desc "Build and upload an iOS build to TestFlight"
  lane :beta do
    ship(scheme: "Still-iOS", platform: "iOS", destination: "generic/platform=iOS", tf_platform: "ios")
  end

  desc "Submit the latest processed iOS build for App Review"
  lane :submit do
    deliver(
      api_key: asc_api_key,
      platform: "ios",
      metadata_path: File.join(ROOT, "fastlane", "metadata"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end

platform :mac do
  desc "Upload the Mac listing: metadata and screenshots"
  lane :metadata do
    deliver_metadata(platform: "osx", metadata_path: "metadata_macos")
  end

  desc "Build and upload a Mac build to TestFlight"
  lane :beta do
    ship(scheme: "Still-macOS", platform: "macOS", destination: "generic/platform=macOS", tf_platform: "macos", pkg: true)
  end

  desc "Submit the latest processed Mac build for App Review"
  lane :submit do
    deliver(
      api_key: asc_api_key,
      platform: "osx",
      metadata_path: File.join(ROOT, "fastlane", "metadata_macos"),
      skip_binary_upload: true,
      skip_screenshots: true,
      submit_for_review: true,
      automatic_release: true,
      force: true,
      submission_information: { add_id_info_uses_idfa: false, export_compliance_uses_encryption: false }
    )
  end
end
